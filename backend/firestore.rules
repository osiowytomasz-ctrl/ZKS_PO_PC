rules_version = '2';
// Reguły Firestore (projekt harmonohram-zks) – poziomy dostępu do Harmonogramu z claimu `harm` w tokenie (backend/Firebase.gs):
//   god     – odczyt, dodawanie, edycja, usuwanie, ustawienia (config/main: stanowiska, kolory komisów, święta)
//   master  – odczyt, dodawanie, edycja (usuwanie blokują aplikacje; reguła pozwala usuwać klucze, bo zmiana numeru = przeniesienie)
//   clerik  – odczyt i dodawanie nowych operacji (bez zmiany i usuwania istniejących)
//   tourist – tylko odczyt
//   none    – brak dostępu
// Token bez `harm` (stary Firebase.gs): tylko odczyt dla osób z dostępem do Planu lub Grafiku.
service cloud.firestore {
  match /databases/{database}/documents {
    function tok() { return request.auth.token; }
    function legacy() {
      return (tok().get('plan', 'none') in ['read', 'write'] || tok().get('grafik', 'none') in ['read', 'write']) ? 'tourist' : 'none';
    }
    function lvl() { return request.auth == null ? 'none' : tok().get('harm', legacy()); }
    function canView() { return lvl() in ['tourist', 'clerik', 'master', 'god']; }
    function canAdd() { return lvl() in ['clerik', 'master', 'god']; }
    function canEdit() { return lvl() in ['master', 'god']; }
    function isGod() { return lvl() == 'god'; }
    // Plan i Grafik: poziomy z claimów `plan` i `grafik` (read / write)
    function planLvl() { return request.auth == null ? 'none' : tok().get('plan', 'none'); }
    function grLvl() { return request.auth == null ? 'none' : tok().get('grafik', 'none'); }
    // poziom Grafiku i Kompetencji (claim `grl`, kolumna „Grafik dostęp”); stary token: zapis w Grafiku = master, odczyt = tourist
    function grlLegacy() { return grLvl() == 'write' ? 'master' : (grLvl() == 'read' ? 'tourist' : 'none'); }
    function grl() { return request.auth == null ? 'none' : tok().get('grl', grlLegacy()); }
    function grView() { return grl() in ['tourist', 'clerik', 'master', 'god']; }
    function grCells() { return grl() in ['clerik', 'master', 'god']; }      // wpisy zmian i komentarze
    function grManage() { return grl() in ['master', 'god']; }               // pracownicy, urlopy, Kompetencje, święta
    function grRead() { return grView() || planLvl() in ['read', 'write'] || canView(); }
    // tylko nowe klucze w mapie ops (bez zmiany i usuwania istniejących operacji)
    function onlyAdds() {
      let before = resource.data.get('ops', {});
      let after = request.resource.data.get('ops', {});
      let d = after.diff(before);
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ops'])
        && d.removedKeys().size() == 0 && d.changedKeys().size() == 0;
    }

    // operacje harmonogramu: dokumenty-paczki {ops: {lp: operacja}}
    match /harm_ops/{chunk} {
      allow read: if canView();
      allow create: if canAdd() && request.resource.data.keys().hasOnly(['ops']);
      allow update: if canEdit() || (canAdd() && onlyAdds());
      allow delete: if isGod();
    }

    // archiwum zakończonych operacji: przeglądanie jak harmonogram, przenoszenie i przywracanie – tylko GOD
    match /harm_archive/{chunk} {
      allow read: if canView();
      allow write: if isGod();
    }

    // ustawienia harmonogramu: stanowiska, kolory komisów, święta. Święta są wspólne dla programu (Ustawienia):
    // czyta też Grafik i Plan, a samą listę świąt może zmienić także osoba z prawem zapisu w Grafiku.
    match /config/{doc} {
      allow read: if canView() || grRead();
      allow create: if isGod() || (grManage() && request.resource.data.keys().hasOnly(['holidays']));
      allow update: if isGod() || (grManage() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['holidays']));
      allow delete: if isGod();
    }

    // Workflow (dawniej karta Z): zadania czyta i edytuje każdy zalogowany użytkownik programu (jak wcześniej w arkuszu);
    // usuwanie (import z karty Z zastępuje listę) – tylko GOD
    match /wf_tasks/{id} {
      allow read, create, update: if request.auth != null;
      allow delete: if isGod();
    }
    match /wf_meta/{id} {
      allow read, write: if request.auth != null;
    }

    // Kody dostępu do Grafiku na telefonie (GrafikKod.gs czyta je kontem usługi): nadaje i odbiera MASTER / GOD.
    match /gr_codes/{d} {
      allow read, write: if grManage();
    }
    // Kolejka wysyłki do arkusza (sync/grafik, sync/plan): dopisuje każdy, kto zapisuje w Grafiku lub Planie; wysyłkę (usunięcie
    // wysłanych pozycji) robi MASTER lub GOD – programy pokazują przycisk tylko im, a sam zapis do arkusza sprawdza też serwer.
    match /sync/{name} {
      allow read: if grRead() || planLvl() in ['read', 'write'];
      allow write: if grCells() || planLvl() == 'write';
    }

    // Pomiary (karta pomiaru): karty czyta i dodaje każdy zalogowany użytkownik programu; zmiana i usuwanie (import z arkusza) – tylko GOD.
    // Szkic karty w trakcie wypełniania – tylko właściciel (dokument o id = uid z tokenu).
    match /karta/{id} {
      allow read, create: if request.auth != null;
      allow update, delete: if isGod() || grl() == 'god';
    }
    match /karta_draft/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Mistrz PO: dane wpisywane zakładek arkusza Mistrz_po (mp_meta/main, mp_rows/{zakładka_paczka}); kolumny liczone liczy program.
    // Odczyt od CLERIK, import (zastąpienie danych) od MASTER – poziom z kolumny „Grafik dostęp” (claim grl).
    match /mp_meta/{doc} {
      allow read: if grCells();
      allow write: if grManage();
    }
    match /mp_rows/{chunk} {
      allow read: if grCells();
      allow write: if grManage();
    }
    // Mistrz PO: zatwierdzenia wypuszczenia dokumentu (Lista detali) – dane programu; czyta CLERIK+, zatwierdza MASTER+
    match /mp_marks/{id} {
      allow read: if grCells();
      allow write: if grManage();
    }

    // Narzędziownia: dane konturów z arkusza (nd_meta/main, nd_meta/mounts, nd_rows/{paczka}: PSWT D:N, BH/BC/BE, ND_CACHE V) –
    // czyta każdy zalogowany, przesyła z arkusza i poprawia po zatwierdzeniu konturu MASTER / GOD
    match /nd_meta/{doc} {
      allow read: if request.auth != null;
      allow write: if grManage();
    }
    // Migawki danych z arkusza (BN, produkty PSWT, narzędzia pomiarowe POM + Badania 2026): czyta każdy zalogowany,
    // zapisuje (przycisk „Odśwież z arkusza”) MASTER / GOD. snap_meta/{klucz}, snap_rows/{klucz}_{i} (fragmenty JSON).
    // Migawka karty ZN (zniszczone narzędzia – klucz `zn`) może zapisać każdy zalogowany: narzędziowiec dopisuje wpis w arkuszu i od razu odświeża wspólną kopię.
    match /snap_meta/{key} {
      allow read: if request.auth != null;
      allow write: if grManage() || key == 'zn';
    }
    match /snap_rows/{chunk} {
      allow read: if request.auth != null;
      allow write: if grManage() || chunk.matches('zn_[0-9]+');
    }
    match /nd_rows/{chunk} {
      allow read: if request.auth != null;
      allow write: if grManage();
    }

    // Status i dostępność pracowników (menu w prawym dolnym rogu programu): bieżący stan czyta każdy zalogowany, własny dokument (id = uid) zapisuje tylko jego właściciel.
    // Dziennik zmian (presence_log/{rrrr-mm-dd}, mapa wpisów `e`) dopisuje każdy zalogowany, a czytają go tylko wskazane osoby (claim `name` z tokenu).
    function historyUser() { return request.auth != null && tok().get('name', '').lower() in ['osiowy tomasz', 'kumała łukasz', 'kumala łukasz', 'skupnik adam']; }
    match /presence/{uid} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null && request.auth.uid == uid;
      allow delete: if request.auth != null && request.auth.uid == uid || isGod();
    }
    // Urządzenia pracowników (wersja programu PC i aplikacji na Androida, id = {uid}_{pc|android}): zgłasza własne każdy zalogowany, czyta tylko wskazana osoba (claim `name`).
    match /presence_dev/{id} {
      allow read: if request.auth != null && tok().get('name', '').lower() in ['osiowy tomasz'];
      allow create, update: if request.auth != null && id.matches(request.auth.uid + '_(pc|android)');
      allow delete: if isGod();
    }
    match /presence_log/{day} {
      allow read: if historyUser();
      allow create, update: if request.auth != null && request.resource.data.keys().hasOnly(['e']);
      allow delete: if isGod();
    }

    // Komunikator (okno statusu): rozmowy chat/{rozmowa}__{rrrr-mm-dd} = { t: początek dnia (ms), m: wiadomości }, przechowywane najwyżej 3 dni.
    // Rozmowa ogólna (`all__…`) – każdy zalogowany; prywatna (`dm_{uid}_{uid}__…`) – tylko dwie osoby (uid w identyfikatorze). Starsze niż 3 dni dni są nieczytelne
    // (nawet gdy dokument jeszcze istnieje) i można je usunąć; skrzynka (chat_inbox/{uid}) – powiadomienia o rozmowach prywatnych: czyta tylko właściciel, dopisuje każdy.
    function chatOk(id) { return request.auth != null && (id.matches('all__.*') || (id.matches('dm_.*') && id.matches('.*' + request.auth.uid + '.*'))); }
    match /chat/{id} {
      allow read: if chatOk(id) && (resource == null || resource.data.t > request.time.toMillis() - 4 * 86400000);
      allow create, update: if chatOk(id) && request.resource.data.keys().hasOnly(['t', 'm']);
      allow delete: if chatOk(id) && (resource.data.t < request.time.toMillis() - 3 * 86400000 || isGod());
    }
    match /chat_inbox/{uid} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null;
    }

    // Plan: wspólny układ tabeli (szerokości kolumn, wysokości wierszy, czcionka) – czyta i zmienia każdy z dostępem do Planu
    match /plan_layout/{doc} {
      allow read, write: if planLvl() in ['read', 'write'];
    }
    // Plan: dane (plan_meta/main, plan_rows/{paczka wierszy}) – czyta każdy z dostępem do Planu, zmienia zapis w Planie;
    // do karty PLAN arkusza zmiany trafiają tylko na żądanie (przycisk „Do arkusza”, kolejka sync/plan)
    match /plan_meta/{doc} {
      allow read: if planLvl() in ['read', 'write'];
      allow write: if planLvl() == 'write';
    }
    match /plan_rows/{chunk} {
      allow read: if planLvl() in ['read', 'write'];
      allow write: if planLvl() == 'write';
    }

    // Grafik: kody zmian i nieobecności (gr_days/{rrrr-mm}) oraz pracownicy, miejsca pracy, urlopy, święta (gr_meta/main).
    // Czyta każdy z dostępem do Grafiku, Planu albo Harmonogramu (podpowiedzi zmian, godziny stanowisk); zmienia – zapis w Grafiku.
    match /gr_days/{month} {
      allow read: if grRead();
      allow write: if grCells();
    }
    match /gr_meta/{doc} {
      allow read: if grRead();
      allow write: if grManage();
    }

    // Kompetencje operatorów (kp/main: dane, uprawnienia, matryca umiejętności) – dane kadrowe: tylko MASTER i GOD Grafiku
    match /kp/{doc} {
      allow read, write: if grManage();
    }

    // test połączenia z Ustawień aplikacji PC
    match /test/{doc} {
      allow read, write: if canView();
    }
  }
}
