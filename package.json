{
  "name": "zks-po-pc",
  "productName": "ZKS PO",
  "version": "1.0.0",
  "description": "ZKS PO na komputer: odpowiednik aplikacji na Androida (Electron).",
  "main": "src/main/main.cjs",
  "type": "module",
  "scripts": {
    "start": "electron .",
    "test": "node --test",
    "dist": "electron-builder"
  },
  "build": {
    "appId": "pl.zks.po.pc",
    "productName": "ZKS PO",
    "artifactName": "ZKS-PO-${version}-${os}-${arch}.${ext}",
    "files": [
      "src/**/*",
      "web/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "portable",
        "zip"
      ],
      "icon": "build/icon.png"
    },
    "portable": {
      "artifactName": "ZKS-PO-portable.${ext}"
    },
    "mac": {
      "target": "dmg",
      "icon": "build/icon.png"
    },
    "linux": {
      "target": "AppImage",
      "icon": "build/icon.png"
    }
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "author": "ZKS"
}
