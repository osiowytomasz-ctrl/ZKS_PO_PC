{
  "name": "zks-po-pc",
  "productName": "ZKS PO",
  "version": "1.51.0",
  "description": "ZKS PO na komputer: odpowiednik aplikacji na Androida (Electron).",
  "main": "src/main/main.cjs",
  "type": "module",
  "scripts": {
    "start": "electron .",
    "test": "node --test",
    "dist": "electron-builder",
    "vendor": "esbuild src/renderer/vendor-src/firebase-entry.js --bundle --format=esm --minify --outfile=src/renderer/vendor/firebase.js",
    "runtime": "node scripts/build-runtime.mjs",
    "vendor:three": "esbuild src/renderer/vendor-src/three-entry.js --bundle --format=esm --minify --outfile=src/renderer/vendor/three.js",
    "dist:narz": "electron-builder --win portable zip --x64 -c.extraMetadata.zksEdition=narz -c.productName=\"ZKS PO Narzedziownia\" -c.appId=pl.zks.po.narz -c.directories.output=dist-narz -c.portable.artifactName=ZKS-PO-Narzedziownia-portable.exe -c.artifactName=ZKS-PO-Narzedziownia-${version}-${os}-${arch}.${ext}"
  },
  "build": {
    "appId": "pl.zks.po.pc",
    "productName": "ZKS PO",
    "artifactName": "ZKS-PO-${version}-${os}-${arch}.${ext}",
    "files": [
      "src/**/*",
      "web/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "portable",
        "zip"
      ],
      "icon": "build/icon.png"
    },
    "portable": {
      "artifactName": "ZKS-PO-portable.${ext}"
    },
    "mac": {
      "target": "dmg",
      "icon": "build/icon.png"
    },
    "linux": {
      "target": "AppImage",
      "icon": "build/icon.png"
    }
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.28.2",
    "firebase": "^13.2.0",
    "three": "0.180.0"
  },
  "author": "ZKS"
}
